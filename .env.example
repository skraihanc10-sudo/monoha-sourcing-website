# Copy to .env locally, or set these in Coolify. Never commit real values.
PORT=3000
SITE_URL=https://your-domain.com
# Persistent volume on the server; content and enquiries live here.
DATA_DIR=/data
# Enquiry emails are sent from and to this domain mailbox (Hostinger).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@monohasourcing.international
SMTP_PASS=
# Admin (/admin). Stays switched off until BOTH are set. Set real values
# only in Coolify Environment Variables; use a long random SESSION_SECRET.
ADMIN_PASSWORD=
SESSION_SECRET=
